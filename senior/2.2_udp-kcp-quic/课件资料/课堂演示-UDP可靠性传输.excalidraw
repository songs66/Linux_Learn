      "groupIds": [],
      "roundness": null,
      "seed": 574435357,
      "version": 138,
      "versionNonce": 1479618003,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700315628025,
      "link": null,
      "locked": false,
      "text": "总结：GBN采用的技术包括序号、累积确认、检验和以及计时/重传。",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 21,
      "containerId": null,
      "originalText": "总结：GBN采用的技术包括序号、累积确认、检验和以及计时/重传。"
    },
    {
      "id": "je00Y74foszzOE9RT2tD9",
      "type": "text",
      "x": 377.8784446689982,
      "y": 2950.3110877143004,
      "width": 332,
      "height": 26,
      "angle": 0,
      "strokeColor": "#d9480f",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 689820371,
      "version": 132,
      "versionNonce": 1629457629,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700315628025,
      "link": null,
      "locked": false,
      "text": "因此分组2及之后的分组都将被重传。",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 21,
      "containerId": null,
      "originalText": "因此分组2及之后的分组都将被重传。"
    },
    {
      "id": "V05Jl7Goz1oZxhlgTgERv",
