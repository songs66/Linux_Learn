    {
      "id": "YrEBb2xtcy8hurY6ETllX",
      "type": "text",
      "x": 45.03397581049131,
      "y": 9811.522187974717,
      "width": 203,
      "height": 37,
      "angle": 0,
      "strokeColor": "#d9480f",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
