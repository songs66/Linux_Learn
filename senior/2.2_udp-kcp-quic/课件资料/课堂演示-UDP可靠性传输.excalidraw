      "link": null,
      "locked": false,
      "text": "2.3.3 ARQ协议-选择重传(Selective-repeat)",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 30,
      "containerId": null,
      "originalText": "2.3.3 ARQ协议-选择重传(Selective-repeat)"
    },
