      "boundElements": null,
      "updated": 1700315628025,
      "link": null,
      "locked": false,
      "text": "只重传没有确认的数据。",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 21,
      "containerId": null,
      "originalText": "只重传没有确认的数据。"
    },
    {
      "id": "s5EQIkQUMPB1msQB6GEyK",
      "type": "text",
      "x": 44.23392698236631,
      "y": 3814.322236802842,
      "width": 188,
      "height": 37,
      "angle": 0,
      "strokeColor": "#d9480f",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1962667219,
      "version": 152,
      "versionNonce": 2026502835,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700315628025,
      "link": null,
      "locked": false,
      "text": "2.4 RTT和RTO",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 30,
      "containerId": null,
      "originalText": "2.4 RTT和RTO"
    },
    {
      "id": "iRQM2lT_zSP3Cespvr0Zt",
      "type": "text",
      "x": 73.43396970697569,
      "y": 3882.722200181748,
      "width": 461,
      "height": 26,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 97223955,
      "version": 135,
      "versionNonce": 1290698237,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700315628025,
      "link": null,
      "locked": false,
      "text": "RTO（Retransmission TimeOut）即重传超时时间。",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 21,
      "containerId": null,
      "originalText": "RTO（Retransmission TimeOut）即重传超时时间。"
    },
    {
      "id": "M4sTvnpyxNbz2CfZRQ8Ap",
      "type": "text",
      "x": 74.83396360346006,
      "y": 3927.6221940782325,
      "width": 866,
      "height": 53,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1151762557,
      "version": 139,
      "versionNonce": 499002451,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700315628025,
      "link": null,
      "locked": false,
      "text": "RTT(Round-Trip Time)： 往返时延。表示从发送端发送数据开始，到发送端收到来自接收端的确认\n（接收端收到数据后便立即发送确认），总共经历的时延。",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 47,
      "containerId": null,
      "originalText": "RTT(Round-Trip Time)： 往返时延。表示从发送端发送数据开始，到发送端收到来自接收端的确认\n（接收端收到数据后便立即发送确认），总共经历的时延。"
    },
    {
      "id": "P7_r251DPsJas21p_jZoM",
      "type": "text",
      "x": 644.2339269823665,
      "y": 4004.6222245958106,
      "width": 387,
      "height": 26,
      "angle": 0,
      "strokeColor": "#5c940d",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 2139023891,
      "version": 162,
      "versionNonce": 1170716253,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700315628025,
      "link": null,
      "locked": false,
      "text": "重传包的时间点需要根据RTT/RTO时间计算",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 21,
      "containerId": null,
      "originalText": "重传包的时间点需要根据RTT/RTO时间计算"
    },
    {
      "id": "JI4zpE6JMgjQHiS6DgAvd",
      "type": "text",
      "x": 44.83396360346006,
      "y": 4088.9222123887794,
      "width": 160,
      "height": 37,
      "angle": 0,
      "strokeColor": "#d9480f",
