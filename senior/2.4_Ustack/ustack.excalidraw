      "text": "struct eventpoll\n\n分配 fd.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 69,
      "containerId": null,
      "originalText": "struct eventpoll\n\n分配 fd."
    },
    {
      "id": "04MzoEjd1S1lik632oxCd",
      "type": "text",
      "x": 1155.0000610351562,
      "y": 20549.41668701172,
      "width": 316,
      "height": 360,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 694642376,
      "version": 274,
      "versionNonce": 2105691320,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1715694772735,
      "link": null,
      "locked": false,
      "text": "epoll_ctl(ADD/DEL/MOD);\n\nstruct eventpoll *ep = \n\nif (action == ADD) {\n\n    find(ep->rbr, event);\n    \n} else if (action == DEL) {\n\n} else if (action == MOD) {\n\n} else {\n    assert(0);\n}",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 355,
      "containerId": null,
      "originalText": "epoll_ctl(ADD/DEL/MOD);\n\nstruct eventpoll *ep = \n\nif (action == ADD) {\n\n    find(ep->rbr, event);\n    \n} else if (action == DEL) {\n\n} else if (action == MOD) {\n\n} else {\n    assert(0);\n}"
    },
    {
      "id": "L36otWUKFRFR5aAcFb3Ar",
      "type": "text",
      "x": 512.3333435058594,
      "y": 20380.75,
      "width": 480,
      "height": 219,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
