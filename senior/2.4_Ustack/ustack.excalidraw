      "isDeleted": false,
      "boundElements": null,
      "updated": 1715695023904,
      "link": null,
      "locked": false,
      "text": "epoll_wait(epfd, event, length, timeout);\n\n\n1. timeout < 0;\n   cond_wait();\n2. timeout != 0;\n   cond_waittime();\n3. timeout == 0\n   不等待",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 213,
      "containerId": null,
      "originalText": "epoll_wait(epfd, event, length, timeout);\n\n\n1. timeout < 0;\n   cond_wait();\n2. timeout != 0;\n   cond_waittime();\n3. timeout == 0\n   不等待"
    },
